{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and preferences for JITALX official site members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "streamerHandle": {
          "type": "string",
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "maxLength": 400
        },
        "preferredFormat": {
          "type": "string",
          "enum": ["16:9", "9:16"]
        },
        "newsletterOptIn": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "VideoItem": {
      "title": "VideoItem",
      "description": "Promotional or feature demonstration video entry and production metadata.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "subtitle": {
          "type": "string",
          "maxLength": 260
        },
        "category": {
          "type": "string",
          "enum": ["principale", "modules", "streamer", "social"]
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["16:9", "9:16"]
        },
        "durationLabel": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["storyboard", "published"]
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "posterUrl": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "title", "category", "aspectRatio", "durationLabel", "status", "updatedAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Curated screenshot or editorial studio visual displayed on the JITALX website.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "moduleName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["capture-app", "streamer-obs", "studio-photo"]
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "moduleName", "category", "imageUrl", "updatedAt"]
    },
    "SiteCopy": {
      "title": "SiteCopy",
      "description": "Editable commercial headlines, positioning copy, and official checkout link.",
      "type": "object",
      "properties": {
        "heroTitle": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "heroSubtitle": {
          "type": "string",
          "minLength": 10,
          "maxLength": 360
        },
        "primaryCtaLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "pricingHeadline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 140
        },
        "pricingNote": {
          "type": "string",
          "maxLength": 360
        },
        "gumroadUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["heroTitle", "heroSubtitle", "primaryCtaLabel", "pricingHeadline", "gumroadUrl", "updatedAt"]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Official product announcements and JITALX release notes.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["Produit", "Streamer Studio", "Feuille de route", "Annonce"]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320
        },
        "body": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "publishedLabel": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["published", "draft"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "category", "summary", "body", "publishedLabel", "status", "updatedAt"]
    },
    "PromoContent": {
      "title": "PromoContent",
      "description": "Promotional campaign blocks and commercial highlights managed by admins.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 360
        },
        "ctaLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "ctaUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "active": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "description", "ctaLabel", "ctaUrl", "active", "updatedAt"]
    },
    "ContactRequest": {
      "title": "ContactRequest",
      "description": "Support and commercial inquiries submitted from the Assistance page.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "topic": {
          "type": "string",
          "enum": ["Achat & Licence 7 €", "Streamer Studio & OBS", "Compte & Sauvegarde", "Partenariat & Presse", "Autre question"]
        },
        "message": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "resolved"]
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email", "topic", "message", "status", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents strictly isolated to the owner and verified admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup documents."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/VideoItem" },
      "description": "Catalog of official JITALX videos and storyboard production entries."
    },
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Curated screenshots and studio visuals managed by admins."
    },
    "/siteCopy/{copyId}": {
      "schema": { "$ref": "#/entities/SiteCopy" },
      "description": "Commercial headlines and checkout copy."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "Official JITALX news articles and announcements."
    },
    "/promos/{promoId}": {
      "schema": { "$ref": "#/entities/PromoContent" },
      "description": "Promotional showcase items."
    },
    "/contactRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ContactRequest" },
      "description": "Support inquiries created by authenticated users and triaged by admins."
    }
  }
}
